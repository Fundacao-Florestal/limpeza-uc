rules_version = '2';

// Regras do Limpeza UC. Elas são a trava real dos perfis: a interface só mostra o que estas regras liberam.
//
// Perfis (lista Perfis em acessos/<uid>; uma pessoa pode ter mais de um, ex.: gestor e gerente.
// Acessos antigos têm só o campo Perfil, que vale como lista de um item):
//   admin      tudo; atribui perfis e mantém parâmetros
//   gestor     cria e edita só as estruturas que ele mesmo criou, nas UCs atribuídas (campo UCs)
//   gerente    lê as estruturas das suas Gerências (campo Gerencias) e aprova ou devolve as que estão "Em validação"
//   validador  lê as estruturas aprovadas e faz a validação final (Validado -> Homologado) ou devolve
//   final      lê apenas estruturas com validação final (Homologado)
// Fluxo de Status: Rascunho -> Em validação -> Validado -> Homologado; Devolvido volta ao gestor.

service cloud.firestore {
  match /databases/{database}/documents {

    // Restrinja aqui o domínio institucional, se quiser travar no banco. Exemplo:
    //   return request.auth.token.email.matches('.*@exemplo[.]sp[.]gov[.]br$');
    function contaPermitida() {
      return true;
    }

    // Login por e-mail e senha, sem exigir confirmação do e-mail. Quem decide o acesso é o
    // Administrador, ao atribuir o perfil: sem perfil, a conta só consegue pedir acesso.
    // Como o e-mail não é confirmado, o Administrador deve conferir com a pessoa antes de aprovar.
    // Para voltar a exigir a confirmação, acrescente: && request.auth.token.email_verified == true
    function signedIn() {
      return request.auth != null && contaPermitida();
    }
    function accPath() {
      return /databases/$(database)/documents/acessos/$(request.auth.uid);
    }
    function hasAcc() {
      return signedIn() && exists(accPath());
    }
    function acc() {
      return get(accPath()).data;
    }
    // Lista de perfis da pessoa; acesso antigo, só com Perfil, vale como lista de um item.
    function perfis() {
      return !hasAcc() ? [] : acc().get('Perfis', [acc().get('Perfil', '')]);
    }
    function tem(p) {
      return p in perfis();
    }
    function isAdmin() {
      return tem('admin');
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Nome e e-mail de quem já entrou, para exibir nomes e para o Administrador encontrar pessoas.
    match /usuarios/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.Uid == uid
        && request.resource.data.keys().hasOnly(['Uid', 'Nome', 'Email', 'UltimoAcesso']);
      allow delete: if isAdmin();
    }

    match /acessos/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Pedido de perfil feito por quem ainda não tem acesso.
    match /pedidos/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // A pessoa marca um ou mais papéis; "outro" é só informativo. Nunca pode pedir "admin".
      allow create, update: if signedIn() && request.auth.uid == uid && !hasAcc()
        && request.resource.data.keys().hasOnly(['Uid', 'Perfis', 'Perfil', 'UCs', 'Gerencias', 'Outro', 'Obs', 'Em'])
        && request.resource.data.Uid == uid
        && request.resource.data.Perfis is list
        && request.resource.data.Perfis.size() >= 1
        && request.resource.data.Perfis.toSet().difference(['gestor', 'gerente', 'validador', 'final', 'outro'].toSet()).size() == 0
        && request.resource.data.get('UCs', []) is list && request.resource.data.get('UCs', []).size() <= 200
        && request.resource.data.get('Gerencias', []) is list && request.resource.data.get('Gerencias', []).size() <= 20
        && request.resource.data.get('Outro', '') is string && request.resource.data.get('Outro', '').size() <= 200
        && request.resource.data.get('Obs', '') is string && request.resource.data.get('Obs', '').size() <= 400;
      allow delete: if isAdmin();
    }

    match /estruturas/{id} {
      function cur() { return resource.data; }
      function nxt() { return request.resource.data; }

      // Gerente e Validador só mudam o andamento, nunca o conteúdo do diagnóstico.
      function soAndamento() {
        return nxt().diff(cur()).affectedKeys().hasOnly(['Status', 'MotivoDevolucao', 'AtualizadoEm', 'Hist']);
      }
      function gestorDono() {
        return tem('gestor')
          && nxt().CriadoPor == request.auth.uid
          && nxt().UC in acc().get('UCs', []);
      }
      // Gestor salva rascunho ou envia para aprovação; editar algo aprovado reabre o fluxo.
      function statusDoGestor() {
        return nxt().Status in ['Rascunho', 'Em validação'] || nxt().get('Excluido', false) == true;
      }

      allow read: if isAdmin()
        || (tem('gestor') && cur().CriadoPor == request.auth.uid)
        || (tem('gerente') && cur().Gerencia in acc().get('Gerencias', []))
        || (tem('validador') && cur().Status in ['Validado', 'Homologado', 'Devolvido'])
        || (tem('final') && cur().Status == 'Homologado');

      allow create: if isAdmin()
        || (gestorDono() && nxt().ID is string && nxt().Status in ['Rascunho', 'Em validação']
            && nxt().get('Excluido', false) == false);

      allow update: if isAdmin()
        || (gestorDono() && cur().CriadoPor == request.auth.uid && cur().UC in acc().get('UCs', []) && statusDoGestor())
        || (tem('gerente') && cur().Gerencia in acc().get('Gerencias', [])
            && cur().Status == 'Em validação' && nxt().Status in ['Validado', 'Devolvido'] && soAndamento())
        || (tem('validador')
            && cur().Status == 'Validado' && nxt().Status in ['Homologado', 'Devolvido'] && soAndamento());

      allow delete: if isAdmin();
    }
  }
}
